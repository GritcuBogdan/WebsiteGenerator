# Cloudflare credentials for the deployment pipeline
# (packages/deploy, packages/domain-provisioning, packages/redirects).
#
# Copy this file to .env and fill in real values. .env itself is
# gitignored — never commit real credentials.

# API token with Cloudflare Pages + Workers + Workers KV storage edit
# permissions, scoped to the account below.
CLOUDFLARE_API_TOKEN=

# The Cloudflare account these sites deploy under.
CLOUDFLARE_ACCOUNT_ID=

# KV namespace id the redirect Worker reads slug -> affiliateUrl from.
CLOUDFLARE_KV_NAMESPACE_ID=

# Name of the deployed Worker that serves /go/<slug> redirects.
CLOUDFLARE_REDIRECT_WORKER_NAME=

# Hostinger credentials for the domain handoff (packages/domain-
# provisioning's HostingerDomainHandoffService, packages/hostinger-client).
# Automates what used to be a manual step after buying a domain on
# Hostinger: switching its nameservers to Cloudflare's so the rest of the
# pipeline (above) can take over. See HOSTINGER_DOMAIN_HANDOFF.md for how
# this works end to end.
#
# Optional — leave unset and every site's "generate" run simply skips this
# step (NoopHostingerDomainHandoffService), same as before this feature
# existed. Only needed once you're ready to automate the handoff for
# domains actually registered through Hostinger.
#
# Bearer token from hPanel -> Account -> API (needs domain + DNS zone
# permissions for the domains this pipeline manages).
HOSTINGER_API_TOKEN=

# Only override if Hostinger tells you to use a different API host (e.g. a
# staging/regional endpoint). Defaults to https://developers.hostinger.com.
HOSTINGER_API_BASE_URL=
