---
import { cssVars } from "../lib/theme";
import { getRedirectHref } from "../lib/affiliate";
import OptimizedImage from "./OptimizedImage.astro";
import SlotsSlider from "./SlotsSlider.astro";

const {
  id = "intro",
  title = "",
  casinoSlug = "",
  paragraphs = [],
  banner = {
    desktop: "",
    mobile: "",
    alt: "",
    text: "",
    textColor: "",
    buttonText: "",
    buttonLink: "#",
    buttonColor: "",
    buttonTextColor: "",
  },
  slotsSlider,
  theme = {},
} = Astro.props;

const redirectHref = getRedirectHref(casinoSlug);
const hasBanner = Boolean(banner.desktop);
// The hero is a first-impression/above-the-fold element - the full
// multi-paragraph intro (2-3 paragraphs from content-library's combined
// entries) reads as too long here. Showing roughly half keeps it a quick
// read while the rest of the page still carries the full content.
const shownParagraphs = paragraphs.slice(0, Math.max(1, Math.ceil(paragraphs.length / 2)));
---

<section
  id={id}
  class="site-section relative overflow-hidden px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20"
  style={`${cssVars(theme)} --section-bg:${theme.background || "transparent"};`}
>
  <div class="relative mx-auto grid max-w-7xl items-center gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:gap-12">
    <div class="order-2 max-w-2xl lg:order-1">
      <h1 class="gradient-heading text-4xl font-black leading-[1.05] tracking-tight sm:text-5xl md:text-6xl">
        {title}
      </h1>

      {
        shownParagraphs.map((paragraph) => (
          <p class="mt-5 max-w-xl text-base leading-8 sm:text-lg" style="color:var(--muted-text);">
            {paragraph}
          </p>
        ))
      }
    </div>

    {
      hasBanner && (
        // Shown at every breakpoint, not just desktop - a page's hero
        // banner is meant to be the first thing a visitor sees, mobile
        // included, so it can't be reduced to a faint full-bleed tint.
        // Ordered before the text column on mobile (order-1) so it's
        // literally the first thing in view; desktop keeps the original
        // text-left/image-right split via lg:order-2.
        <div class="glass-card glow-border group relative order-1 overflow-hidden rounded-3xl lg:order-2">
          <OptimizedImage
            src={banner.desktop}
            mobileSrc={banner.mobile}
            alt={banner.alt || title}
            width="900"
            height="700"
            loading="eager"
            fetchpriority="high"
            class="aspect-[16/11] w-full object-cover transition duration-700 group-hover:scale-[1.03] sm:aspect-[4/3] lg:aspect-[9/7]"
          />

          {(banner.text || banner.buttonText) && (
            <div
              class="absolute inset-0 flex flex-col items-start justify-end gap-4 p-5 sm:p-7"
              style="background:linear-gradient(180deg, transparent 25%, rgba(6,5,14,0.55) 60%, rgba(6,5,14,0.94) 100%);"
            >
              {banner.text && (
                <p
                  class="text-xl font-black leading-tight drop-shadow-lg sm:text-2xl md:text-3xl"
                  style={`color:${banner.textColor || "#ffffff"};`}
                >
                  {banner.text}
                </p>
              )}

              {banner.buttonText && (
                <a
                  href={redirectHref}
                  class="cta-button glow-pulse inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-black shadow-xl sm:px-7 sm:py-3.5 sm:text-base"
                >
                  {banner.buttonText}
                  <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          )}
        </div>
      )
    }
  </div>

  {
    slotsSlider && (
      <SlotsSlider title={slotsSlider.title} slots={slotsSlider.slots} casinoSlug={casinoSlug} theme={theme} />
    )
  }
</section>
