---
import { cssVars } from "../lib/theme";
import { getRedirectHref } from "../lib/affiliate";
import OptimizedImage from "./OptimizedImage.astro";

const {
  id = "slots",
  title = "Featured Slots",
  casinoSlug = "",
  subtitle = "",
  slots = [],
  playText = "Play",
  demoText = "Demo",
  theme = {},
} = Astro.props;

const redirectHref = getRedirectHref(casinoSlug);
const sectionBg = theme.background || theme.sectionBackground || "transparent";
---

<section
  id={id}
  class="site-section px-4 py-10 sm:px-6 sm:py-12 lg:px-8"
  style={`${cssVars(theme)} --section-bg:${sectionBg};`}
>
  <div class="mx-auto max-w-7xl">
    <div class="max-w-3xl">
      <h2 class="gradient-heading text-2xl font-black sm:text-3xl md:text-4xl">{title}</h2>
      {subtitle && <p class="mt-3 leading-8" style="color:var(--muted-text)">{subtitle}</p>}
    </div>

    <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {
        slots.map((slot) => (
          <a
            href={redirectHref}
            class="glass-card group relative min-h-64 overflow-hidden rounded-2xl transition duration-300 hover:-translate-y-1 hover:glow-border"
            aria-label={`${slot.title} - ${playText}`}
          >
            <OptimizedImage
              src={slot.image}
              alt={slot.alt || slot.title}
              loading="lazy"
              width="320"
              height="420"
              class="h-52 w-full object-cover transition duration-500 group-hover:scale-105"
            />
            <div class="p-3">
              <h3 class="line-clamp-2 text-sm font-black" style="color:var(--text)">
                {slot.title}
              </h3>
            </div>
            <div
              class="absolute inset-0 flex translate-y-4 items-center justify-center gap-2 p-3 opacity-0 transition duration-300 group-hover:translate-y-0 group-hover:opacity-100"
              style="background:color-mix(in srgb, var(--background) 78%, transparent);"
            >
              <span class="cta-button rounded-full px-4 py-2 text-sm font-black">{playText}</span>
              <span class="ghost-button rounded-full px-4 py-2 text-sm font-black">{demoText}</span>
            </div>
          </a>
        ))
      }
    </div>

    {
      slots.length === 0 && (
        <p class="mt-6 text-sm" style="color:var(--muted-text)">
          No slots available yet.
        </p>
      )
    }
  </div>
</section>
