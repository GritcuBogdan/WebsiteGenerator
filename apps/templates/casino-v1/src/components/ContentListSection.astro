---
import { cssVars } from "../lib/theme";

const {
  id,
  title,
  paragraphs = [],
  items = [],
  theme = {
    primary: "#2563eb",
    secondary: "#111827",
    text: "#1f2937",
  },
} = Astro.props;

const sectionBg = theme.background || theme.sectionBackground || "transparent";
const sectionText = theme.text || theme.sectionText || "var(--text)";
const titleColor = theme.title || theme.headingText || "var(--heading-text)";
---

<section
  id={id}
  class="site-section px-4 py-7 sm:px-6 sm:py-9 lg:px-8"
  style={`${cssVars(theme)} --section-bg:${sectionBg}; --section-text:${sectionText};`}
>
  <div class="mx-auto max-w-7xl">
    <h2 class="text-2xl font-black sm:text-3xl md:text-4xl" style={`color:${titleColor}`}>
      {title}
    </h2>

    {paragraphs.slice(0, 1).map((text) => <p class="mt-4 leading-8" style="color:var(--muted-text)">{text}</p>)}

    {
      items.length > 0 && (
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {items.map((item) => (
            <li class="rounded-lg border p-4 leading-7 shadow-sm" style="background:var(--surface); border-color:var(--border); color:var(--section-text)">
              {item}
            </li>
          ))}
        </ul>
      )
    }

    {paragraphs.slice(1).map((text) => <p class="mt-4 leading-8" style="color:var(--muted-text)">{text}</p>)}
  </div>
</section>
