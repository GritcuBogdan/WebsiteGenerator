---
import { cssVars } from "../lib/theme";
import { getRedirectHref } from "../lib/affiliate";
import OptimizedImage from "./OptimizedImage.astro";

const {
  id = "slots",
  title = "Featured Slots",
  casinoSlug = "",
  subtitle = "",
  slots = [],
  playText = "Play",
  demoText = "Demo",
  theme = {},
} = Astro.props;

const redirectHref = getRedirectHref(casinoSlug);
const sectionBg = theme.background || theme.sectionBackground || "transparent";
const titleColor = theme.title || theme.headingText || "var(--heading-text)";
const cardBg = theme.cardBackground || theme.surface || "#ffffff";
---

<section
  id={id}
  class="site-section px-4 py-7 sm:px-6 sm:py-9 lg:px-8"
  style={`${cssVars(theme)} --section-bg:${sectionBg}; --section-text:${theme.text || "var(--text)"};`}
>
  <div class="mx-auto max-w-7xl">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-black sm:text-3xl md:text-4xl" style={`color:${titleColor}`}>
        {title}
      </h2>
      {subtitle && <p class="mt-3 leading-8" style="color:var(--muted-text)">{subtitle}</p>}
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
      {
        slots.map((slot) => (
          <a
            href={redirectHref}
            class="group relative min-h-64 overflow-hidden rounded-lg border shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl focus-visible:-translate-y-1"
            style={`background:${cardBg}; border-color:${theme.border || "var(--border)"};`}
            aria-label={`${slot.title} - ${playText}`}
          >
            <OptimizedImage
              src={slot.image}
              alt={slot.alt || slot.title}
              loading="lazy"
              width="320"
              height="420"
              class="h-52 w-full object-cover transition duration-500 group-hover:scale-105"
            />
            <div class="p-3">
              <h3 class="line-clamp-2 text-sm font-black" style="color:var(--heading-text)">
                {slot.title}
              </h3>
            </div>
            <div class="absolute inset-0 flex translate-y-4 items-center justify-center gap-2 bg-black/55 p-3 opacity-0 transition duration-300 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100">
              <span class="shine-button rounded-lg px-4 py-2 text-sm font-black" style="background:var(--primary); color:#ffffff">
                {playText}
              </span>
              <span class="rounded-lg border px-4 py-2 text-sm font-black text-white transition duration-300 group-hover:scale-105" style="border-color:rgb(255 255 255 / 0.7)">
                {demoText}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
